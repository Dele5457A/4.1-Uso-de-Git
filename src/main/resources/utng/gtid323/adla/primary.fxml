<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" spacing="15.0" xmlns="http://javafx.com/javafx/13" xmlns:fx="http://javafx.com/fxml/1" fx:controller="utng.gtid323.adla.PrimaryController">
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
   <children>
      <Label text="Tienda - Control de Productos">
         <font>
            <Font name="System Bold" size="18.0" />
         </font>
      </Label>
      <HBox alignment="CENTER" spacing="10.0">
         <children>
            <TextField fx:id="txtNombre" promptText="Nombre" />
            <TextField fx:id="txtPrecio" prefWidth="80.0" promptText="Precio" />
            <TextField fx:id="txtStock" prefWidth="70.0" promptText="Stock" />
            <Button onAction="#guardarProducto" text="Guardar" />
         </children>
      </HBox>
      <TableView fx:id="tblProductos" prefHeight="260.0" prefWidth="480.0">
        <columns>
          <TableColumn fx:id="colId" prefWidth="60.0" text="ID" />
          <TableColumn fx:id="colNombre" prefWidth="200.0" text="Nombre" />
          <TableColumn fx:id="colPrecio" prefWidth="110.0" text="Precio" />
          <TableColumn fx:id="colStock" prefWidth="110.0" text="Stock" />
        </columns>
      </TableView>
   </children>
</VBox>